# Hotel Paradise on the Nile
#
# Two jobs, both of which this folder was missing before.
#
# Needs mod_rewrite. XAMPP has it loaded, and htdocs is set to AllowOverride All,
# so this file is read. On hosting, confirm the same; if mod_rewrite is absent
# the rules below do nothing and the site falls back to what it did before.

# ---------------------------------------------------------------------------
# 1. Keep these folders off the web.
#
#    tools/      the installer creates databases, users and grants
#    database/   the full schema and the seed data
#    docs/, expanded-system-blueprint/, python-services/  project notes
#
#    The command line tools now refuse a web request themselves, but a file that
#    does not need serving should not be reachable at all. Denying it here also
#    means a new file dropped into tools/ is private by default rather than by
#    whoever remembers to add a guard to it.
#
#    [F] is Forbidden. The pattern has no leading slash, because inside a
#    .htaccess it is matched against the path relative to this directory, which
#    is what a leading slash quietly broke before: the rule never matched, and
#    /docs/ served a full index of itself.
# ---------------------------------------------------------------------------
<IfModule mod_rewrite.c>
    RewriteEngine On
    RewriteRule ^(tools|database|docs|expanded-system-blueprint|python-services)(/|$) - [F,L]
</IfModule>

# Nothing sensitive of its own, but .env files and shell droppings have no
# business being fetched either.
<FilesMatch "^\.(env|git|htaccess)|~$|\.(bak|old|orig|sql|log|ini)$">
    Require all denied
</FilesMatch>

# ---------------------------------------------------------------------------
# 2. Make the site's own addresses work.
#
#    The public site is a React app: index.html loads, then the router draws
#    /rooms, /dining, /contact, /about and so on without asking the server for
#    anything. Clicking through worked. Opening one of those addresses directly,
#    refreshing, bookmarking, or sending the link to anybody returned 404,
#    because Apache had nothing to serve for /rooms.
#
#    So an unmatched address with no file extension is handed index.html and
#    the router takes over.
# ---------------------------------------------------------------------------
<IfModule mod_rewrite.c>
    RewriteEngine On

    # Something that really is there wins: the built assets in assets/, the
    # images, backend-php/, system/.
    RewriteCond %{REQUEST_FILENAME} -f [OR]
    RewriteCond %{REQUEST_FILENAME} -d
    RewriteRule ^ - [L]

    # A hashed name a browser is still holding from an earlier deploy, pointed
    # at the file the current build gives that same piece of the site. Builds
    # now name their bundles after what they are rather than after their
    # contents (see frontend-react/vite.config.ts), so home.js, shared.js,
    # SmartImage.js and shared.css are the names that last; this rule answers
    # for the older -8characterhash spellings that are still written into pages
    # a browser has cached, and for any that a proxy has kept.
    RewriteRule ^assets/([A-Za-z0-9_]+)-[A-Za-z0-9_-]{4,}\.(js|css)$ assets/$1.$2 [L]

    # A real request for something that is missing stays missing. Without this
    # the rule below would answer a missing stylesheet, a wrong API path or a
    # mistyped .php with the whole application and an HTTP 200, and the fault
    # would show up as a blank page instead of a 404 in the log.
    RewriteCond %{REQUEST_URI} !\.(php|json|js|mjs|css|map|png|jpe?g|gif|svg|ico|webp|avif|woff2?|ttf|eot|mp4|webm|txt|xml|map)$ [NC]

    RewriteRule ^ index.html [L]
</IfModule>

# ---------------------------------------------------------------------------
# 3. How long a browser may hold on to what it has fetched.
#
#    A bundle's name no longer changes with its contents, so a name is a promise
#    about the address and nothing about what is inside it: the file behind
#    assets/home.js is rewritten by every deploy. That rules out the long,
#    immutable cache the hashed names used to earn - a guest would be shown
#    yesterday's code for a year - so every built asset is revalidated instead,
#    which costs one 304 per file per visit and always resolves to today's build.
#
#    The pages themselves must never be kept: a page read from yesterday asks
#    for a file today's deploy has already taken away, and the guest gets a 404
#    for the whole site instead of a page.
#
#    mod_headers supplies the header; without it these lines do nothing and
#    the browser falls back to the heuristics it used before.
# ---------------------------------------------------------------------------
<IfModule mod_headers.c>
    Header set Cache-Control "no-cache, must-revalidate" "expr=%{REQUEST_URI} =~ m#\.html$#"
    Header set Cache-Control "no-cache, must-revalidate" "expr=%{REQUEST_URI} =~ m#/assets/#"
    Header set Cache-Control "public, max-age=604800" "expr=%{REQUEST_URI} =~ m#^/images/#"
</IfModule>

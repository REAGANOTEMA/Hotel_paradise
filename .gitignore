# Dependencies
frontend-react/node_modules/

# Real database credentials. This file is generated on each server and must
# never be committed: it holds the live MySQL user and password.
backend-php/config.php

# Signing identity for Browser Web Push (VAPID). Like config.php, this is
# generated per server and must never be committed: whoever holds it can send
# notifications that the hotel's own phones trust.
backend-php/vapid.php

# Build output is generated by "npm run build" and then copied to the site root.
frontend-react/dist/

# Logs and local scratch
*.log
php_error.log
.DS_Store

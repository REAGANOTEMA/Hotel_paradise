{
  "name": "Hotel Paradise on the Nile",
  "short_name": "Hotel Paradise",
  "description": "The official app for Hotel Paradise on the Nile, Jinja. View the food menu and order, see the rooms and book your stay, in one place.",
  "id": "./",
  "start_url": "./?source=pwa",
  "scope": "./",
  "display": "standalone",
  "display_override": ["standalone", "minimal-ui", "browser"],
  "orientation": "any",
  "launch_handler": { "client_mode": "navigate-existing" },
  "background_color": "#071A33",
  "theme_color": "#071A33",
  "lang": "en",
  "dir": "ltr",
  "categories": ["travel", "food", "business"],
  "icons": [
    { "src": "icon-192.png", "sizes": "192x192", "type": "image/png", "purpose": "any" },
    { "src": "icon-512.png", "sizes": "512x512", "type": "image/png", "purpose": "any" },
    { "src": "icon-maskable-512.png", "sizes": "512x512", "type": "image/png", "purpose": "maskable" },
    { "src": "logo-192.png", "sizes": "192x192", "type": "image/png", "purpose": "any" }
  ],
  "shortcuts": [
    {
      "name": "Book a room",
      "short_name": "Book",
      "description": "See the rooms and begin a booking",
      "url": "./rooms.html",
      "icons": [{ "src": "icon-192.png", "sizes": "192x192", "type": "image/png" }]
    },
    {
      "name": "View the menu and order",
      "short_name": "Menu",
      "description": "Open the food menu and place an order",
      "url": "./menu.html",
      "icons": [{ "src": "icon-192.png", "sizes": "192x192", "type": "image/png" }]
    }
  ],
  "prefer_related_applications": false
}
